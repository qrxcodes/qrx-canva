{
  "name": "qrx-canva",
  "version": "0.1.0",
  "private": true,
  "description": "QRX for Canva: make an art QR code from a prompt and a link, and add it to your design.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrxcodes/qrx-canva.git"
  },
  "homepage": "https://qrx.codes",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "build": "canva apps build",
    "start": "canva apps start",
    "start:preview": "canva apps start --preview",
    "format": "prettier \"**/*.{css,ts,tsx}\" --write",
    "format:check": "prettier \"**/*.{css,ts,tsx}\" --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc",
    "typecheck": "tsc",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "portal-config": "tsx ./scripts/portal_config.ts",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.15.0",
    "@canva/asset": "^2.3.1",
    "@canva/design": "^2.13.1",
    "@canva/error": "^2.2.2",
    "@canva/intents": "^2.7.1",
    "@canva/platform": "^2.2.3",
    "@canva/user": "^2.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.11",
    "obscenity": "0.4.6"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.1",
    "@canva/app-scripts": "^1.1.2",
    "@rspack/core": "2.0.8",
    "@swc/core": "1.15.1",
    "@swc/jest": "0.2.39",
    "@swc/plugin-formatjs": "8.0.0",
    "@testing-library/react": "16.3.0",
    "@types/debug": "4.1.12",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.17",
    "@types/node-fetch": "2.6.13",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "debug": "4.4.1",
    "express": "4.22.2",
    "express-basic-auth": "1.2.1",
    "jest": "30.2.0",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "30.2.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.0",
    "node-fetch": "3.3.2",
    "prettier": "3.6.2",
    "ts-jest": "29.4.1",
    "tsx": "4.22.4",
    "typescript": "5.9.2",
    "@canva/cli": "2.14.0"
  },
  "overrides": {
    "nwsapi": "2.2.24",
    "@canva/app-scripts": {
      "@rspack/core": "$@rspack/core"
    }
  }
}
