# Canva Developer Portal > your app > Security > Credentials > .env file
CANVA_APP_ID=
CANVA_APP_ORIGIN=
CANVA_FRONTEND_PORT=8080
CANVA_HMR_ENABLED=FALSE

# QRX API. Use https://dev.qrx.codes while developing; production builds use https://qrx.codes.
QRX_API_BASE=https://dev.qrx.codes
# "canva" sends requests to /canva/v1 with the Canva user token (request verification);
# "direct" sends them to /v1 with the QRX access token only.
QRX_API_MODE=canva
# Header that carries the QRX access token in "canva" mode.
QRX_TOKEN_HEADER=X-QRX-Authorization
# Scopes requested when connecting a QRX account (space separated).
QRX_OAUTH_SCOPES=qrx:read qrx:generate offline_access
# RFC 8707 resource for the token audience. Defaults to <QRX_API_BASE>/v1; "none" sends none.
QRX_OAUTH_RESOURCE=
# Optional auth provider name, when the Developer Portal has more than one.
QRX_OAUTH_PROVIDER=

# Used by `npm run portal-config` to print the Developer Portal auth provider settings.
# The client ID and secret themselves are entered in the Developer Portal, never in the bundle.
QRX_OAUTH_ISSUER=https://summary-bobcat-19.clerk.accounts.dev
# Dev Clerk "QRX for Canva" app (public identifier, not a secret).
QRX_OAUTH_CLIENT_ID=DbRxTAmnNNHtIU6Y
